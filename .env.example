# Finnhub: market quotes, fundamentals, FX and fallback earnings data
FINNHUB_API_KEY=replace_with_your_finnhub_key

# SEC asks automated clients to identify themselves and provide a contact email.
# Example: InvestorIntelligenceDashboard your-email@example.com
SEC_USER_AGENT=InvestorIntelligenceDashboard your-email@example.com

# OPTIONAL / PRIVATE-USE ONLY:
# Trading 212 read-only Public API credentials.
# Do not configure live credentials on a public deployment unless you have added
# authentication in front of /.netlify/functions/trading212.
TRADING212_API_KEY=replace_with_your_trading212_api_key
TRADING212_API_SECRET=replace_with_your_trading212_api_secret
TRADING212_ENVIRONMENT=demo
